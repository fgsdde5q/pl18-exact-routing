{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fgsdde5q/pl18-exact-routing/schemas/stage2b-canonical-artifacts.schema.json",
  "title": "Stage 2B canonical TSV artifact schemas",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split-points.tsv.zst", "split-edges.tsv.zst", "internal-turn-states.tsv.zst", "inherited-turn-states.tsv.zst", "gates.tsv.zst", "geometry-models.tsv"],
      "properties": {
        "split-points.tsv.zst": {"$ref": "#/$defs/columns"},
        "split-edges.tsv.zst": {"$ref": "#/$defs/columns"},
        "internal-turn-states.tsv.zst": {"$ref": "#/$defs/columns"},
        "inherited-turn-states.tsv.zst": {"$ref": "#/$defs/columns"},
        "gates.tsv.zst": {"$ref": "#/$defs/columns"},
        "geometry-models.tsv": {"$ref": "#/$defs/columns"}
      }
    }
  },
  "$defs": {
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "header", "canonical_sort"],
      "properties": {
        "format": {"const": "UTF-8 TSV with LF line endings"},
        "header": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "canonical_sort": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
